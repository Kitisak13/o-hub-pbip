/// อัพเดทหรือเปลี่ยน Product Code ของ DIT ที่ step สุดท้าย Filter_Product_Code
expression milled_price_dit =
		let
		    Source = GoogleSheets.Contents("https://docs.google.com/spreadsheets/d/1sYdgKfMBsdiwZhbbP34Iy8wh2q23k_uDjyiui0DXMVY"),
		    Sheet1_Table = Source{[name="millet_dit",ItemKind="Table"]}[Data],
		    #"Promoted Headers" = Table.PromoteHeaders(Sheet1_Table, [PromoteAllScalars=true]),
		    #"Removed Other Columns" = Table.SelectColumns(#"Promoted Headers",{"HeaderDate", "SourceCode", "Country Name", "Category Code", "Category Name", "Sub Category Code", "Sub Category Name", "Product Code", "Product Name", "Min Price", "Max Price"}),
		    #"Filtered Rows" = Table.SelectRows(#"Removed Other Columns", each [SourceCode] = "S003"),
		    #"Changed Type" = Table.TransformColumnTypes(#"Filtered Rows",{{"HeaderDate", type date}}),
		
		    ProductCodeList = {
		        "P00000000144","P00000000145","P00000000146","P00000000147",
		        "P00000000150","P00000000151","P00000000158","P00000000159",
		        "P00000000164","P00000000165","P00000000166","P00000000167",
		        "P00000000168","P00000000169","P00000000175","P00000000176",
		        "P00000000179","P00000000180","P00000000181","P00000000183"
		    },
		
		    Filter_Product_Code = Table.SelectRows(#"Changed Type", each List.Contains(ProductCodeList, [Product Code])),
		    #"Added Custom" = Table.AddColumn(Filter_Product_Code, "Crop Status", each "New"),
		    #"Added Custom1" = Table.AddColumn(#"Added Custom", "Price Selection", each "Keep")
		in
		    #"Added Custom1"
	lineageTag: f0f3ca88-4181-471d-914f-542e32e5178d
