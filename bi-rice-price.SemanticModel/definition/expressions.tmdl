		    oryza_prices_Table = Source{[name="oryza_prices",ItemKind="Table"]}[Data],
		    #"Promoted Headers" = Table.PromoteHeaders(oryza_prices_Table, [PromoteAllScalars=true]),
		    #"Removed Other Columns" = Table.SelectColumns(#"Promoted Headers",{"HeaderDate", "SourceCode", "Country Name", "Category Code", "Category Name", "Sub Category Code", "Sub Category Name", "Product Code", "Product Name", "Min Price", "Max Price"}),
		    #"Filtered Rows" = Table.SelectRows(
		    #"Removed Other Columns",
		    each [SourceCode] = "S005"
		        and [HeaderDate] > #date(2020, 12, 31)
		),
		    #"Changed Type" = Table.TransformColumnTypes(#"Filtered Rows",{{"HeaderDate", type date}}),
		    #"Added Custom" = Table.AddColumn(#"Changed Type", "Crop Status", each "New"),
		    #"Added Custom1" = Table.AddColumn(#"Added Custom", "Price Selection", each "Keep"),
		    #"Filtered Out CBOT and risotto" = Table.SelectRows(#"Added Custom1", each ([Product Name] <> "CBOT Wheat Cents-Bushel" and [Product Name] <> "Italy risotto"))
		in
