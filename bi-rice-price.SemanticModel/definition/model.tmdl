model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: th-TH
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup raw_from_googlesheet

	annotation PBI_QueryGroupOrder = 0

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["milled_price_dit","milled_price_cpi","fob_prices_oryza","Fact_Rice_Price","Fact_Exchange_Rate","Dim_Source","Dim_Currency","Dim_Country","Dim_Product"]

annotation PBI_ProTooling = ["DevMode"]

ref table Fact_Exchange_Rate
ref table Fact_Rice_Price
ref table Dim_Source
ref table Dim_Currency
ref table Dim_Country
ref table Dim_Date
ref table Dim_Product
ref table _Measures

ref cultureInfo en-US

