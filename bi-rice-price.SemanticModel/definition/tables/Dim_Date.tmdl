	column RelativeYear
		formatString: 0
		lineageTag: bc327984-5780-41ef-b671-4fc1252f6b5b
		summarizeBy: sum
		isNameInferred
		sourceColumn: [RelativeYear]

		annotation SummarizationSetBy = Automatic

	partition Dim_Date = calculated
		mode: import
		source =
				
				VAR MinDate =
				    MINX (
				        Fact_Rice_Price,
				        Fact_Rice_Price[HeaderDate]
				    )
				VAR MaxDate =
				    MAXX (
				        Fact_Rice_Price,
				        Fact_Rice_Price[HeaderDate]
				    )
				RETURN
				ADDCOLUMNS (
				    CALENDAR ( MinDate, MaxDate ),
				
				    //-----------------------------------
				    // Keys
				    //-----------------------------------
				    "DateKey",
				        YEAR ( [Date] ) * 10000
				        + MONTH ( [Date] ) * 100
				        + DAY ( [Date] ),
				
				    //-----------------------------------
				    // Year
				    //-----------------------------------
				    "Year",
				        YEAR ( [Date] ),
				
				    "YearShort",
				        RIGHT ( YEAR ( [Date] ), 2 ),
				
				    //-----------------------------------
				    // Quarter
				    //-----------------------------------
				    "QuarterNo",
				        QUARTER ( [Date] ),
				
				    "Quarter",
				        "Q" & QUARTER ( [Date] ),
				
				    //-----------------------------------
				    // Month
				    //-----------------------------------
				    "MonthNo",
				        MONTH ( [Date] ),
				
				    "MonthShort",
				        FORMAT ( [Date], "[$-en-US]MMM" ),
				
				    "MonthLong",
				        FORMAT ( [Date], "[$-en-US]MMMM" ),
				
				    //-----------------------------------
				    // Year-Month
				    //-----------------------------------
				    "YearMonth",
				        FORMAT ( [Date], "yyyy" )
				            & "-"
				            & FORMAT ( [Date], "[$-en-US]MMM" ),
				
				    "YearMonthSort",
				        YEAR ( [Date] ) * 100
				        + MONTH ( [Date] ),
				
				    //-----------------------------------
				    // Week
				    //-----------------------------------
				    "WeekNo",
				        WEEKNUM ( [Date], 2 ),
				
				    //-----------------------------------
				    // Day
				    //-----------------------------------
				    "DayOfMonth",
				        DAY ( [Date] ),
				
				    "DayOfWeekNo",
				        WEEKDAY ( [Date], 2 ),
				
				    "DayShort",
				        FORMAT ( [Date], "[$-en-US]ddd" ),
				
				    "DayLong",
				        FORMAT ( [Date], "[$-en-US]dddd" ),
				
				    //-----------------------------------
				    // Period Start/End
				    //-----------------------------------
				    "MonthStart",
				        DATE (
				            YEAR ( [Date] ),
				            MONTH ( [Date] ),
				            1
				        ),
				
				    "MonthEnd",
				        EOMONTH ( [Date], 0 ),
				
				    "YearStart",
				        DATE (
				            YEAR ( [Date] ),
				            1,
				            1
				        ),
				
				    "YearEnd",
				        DATE (
				            YEAR ( [Date] ),
				            12,
				            31
				        ),
				
				    //-----------------------------------
				    // Current Flags
				    //-----------------------------------
				    "IsCurrentYear",
				        YEAR ( [Date] ) = YEAR ( TODAY () ),
				
				    "IsPreviousYear",
				        YEAR ( [Date] ) = YEAR ( TODAY () ) - 1,
				
				    "IsCurrentMonth",
				        YEAR ( [Date] ) = YEAR ( TODAY () )
				            && MONTH ( [Date] ) = MONTH ( TODAY () ),
				
				    "IsCurrentWeek",
				        YEAR ( [Date] ) = YEAR ( TODAY () )
				            && WEEKNUM ( [Date], 2 ) = WEEKNUM ( TODAY (), 2 ),
				
				    "IsToday",
				        [Date] = TODAY (),
				
				    //-----------------------------------
				    // YTD Flag
				    //-----------------------------------
				    "IsYTD",
				        YEAR ( [Date] ) = YEAR ( TODAY () )
				            && [Date] <= TODAY (),
				
				    //-----------------------------------
				    // Relative Year
				    //-----------------------------------
				    "RelativeYear",
				        YEAR ( [Date] ) - YEAR ( TODAY () )
				)

	annotation PBI_Id = 8d071299a50e4bdb8553accfab40b7de

