	/// กลุ่มเปรียบเทียบมาตรฐานเชื่อมโยง 3 แหล่งข้อมูล (S005 Oryza, S003 DIT, S001 CPI)
	column 'Benchmark Group' =
			VAR _Source = Dim_Product[SourceCode]
			VAR _DomGroup = Dim_Product[Domestic Product Group]
			RETURN
			    SWITCH(
			        _Source,
			        -- Rule 1: SourceCode = S005 (Oryza)
			        "S005", Dim_Product[New Sub Category Name],
			
			        -- Rule 2: SourceCode = S003 (DIT)
			        "S003",
			            SWITCH(
			                _DomGroup,
			                "ปข.นึ่ง A1", "ปลายข้าว",
			                "ข้าวนึ่ง 5%", "ข้าวนึ่ง",
			                "ข้าวนึ่ง 100%", "ข้าวนึ่ง",
			                "ปข.เหนียว A1 (ใหม่)", "ปลายข้าว",
			                "ปข.เหนียว A1", "ปลายข้าว",
			                "ข้าวเหนียว 10% สั้น (ใหม่)", "ข้าวเหนียว",
			                "ข้าวเหนียว 10% สั้น", "ข้าวเหนียว",
			                "ข้าวเหนียว 10% ยาว (ใหม่)", "ข้าวเหนียว",
			                "ข้าวเหนียว 10% ยาว", "ข้าวเหนียว",
			                "ข้าวเหนียว กข. 6 (ใหม่)", "ข้าวเหนียว",
			                "ข้าวเหนียว กข. 6", "ข้าวเหนียว",
			                "ปข.ขาว C1", "ปลายข้าว",
			                "ปข. A1.พิเศษ (ใหม่)", "ปลายข้าว",
			                "ปข. A1.พิเศษ", "ปลายข้าว",
			                "ปข.เจ้า A1 เลิศ (ใหม่)", "ปลายข้าว",
			                "ปข.เจ้า A1 เลิศ", "ปลายข้าว",
			                "ปข.ปทุมธานี (ใหม่)", "ปลายข้าว",
			                "ปข.ปทุมธานี", "ปลายข้าว",
			                "ปข.หอมมะลิ (ใหม่)", "ปลายข้าว",
			                "ปข.หอมมะลิ", "ปลายข้าว",
			                "ขข. 25% เลิศ (ใหม่)", "ข้าวขาว",
			                "ขข. 15% (ใหม่)", "ข้าวขาว",
			                "ขข. 10% (ใหม่)", "ข้าวขาว",
			                "ขข. 10%", "ข้าวขาว",
			                "ขข. 5% (ใหม่)", "ข้าวขาว",
			                "ขข. 5%", "ข้าวขาว",
			                "ขข. 100% ชั้น 3 (ใหม่)", "ข้าวขาว",
			                "ขข. 100% ชั้น 3", "ข้าวขาว",
			                "ขข. 100% ชั้น 2 (ใหม่)", "ข้าวขาว",
			                "ขข. 100% ชั้น 2", "ข้าวขาว",
			                "ขข. 100% ชั้น 1 (ใหม่)", "ข้าวขาว",
			                "ขข. 100% ชั้น 1 (ใหม่ )", "ข้าวขาว",
			                "ขข. 100% ชั้น 1", "ข้าวขาว",
			                "ข้าวปทุมธานี (ใหม่)", "ข้าวปทุมฯ",
			                "ข้าวปทุมธานี", "ข้าวปทุมฯ",
			                "ข้าวหอมจังหวัด (ใหม่)", "ข้าวหอม",
			                "ข้าวหอมจังหวัด", "ข้าวหอม",
			                "หอมมะลิ 100% ชั้น 2 (ใหม่)", "ข้าวหอม",
			                "หอมมะลิ 100% ชั้น 2", "ข้าวหอม",
			                "หอมมะลิ 100% ชั้น 1 (ใหม่)", "ข้าวหอม",
			                "หอมมะลิ 100% ชั้น 1", "ข้าวหอม",
			                "ข้าวอื่นๆ"
			            ),
			
			        -- Rule 3: SourceCode = S001 (CPI)
			        "S001",
			            SWITCH(
			                _DomGroup,
			                "ข้าวกข.43", "ข้าวอื่นๆ",
			                "ข้าวกข.79", "ข้าวปทุมฯ",
			                "ข้าวกล้องหอม 100%", "ข้าวหอม",
			                "ขข. 100% ชั้น 1", "ข้าวขาว",
			                "ขข. 5%", "ข้าวขาว",
			                "ข้าวญี่ปุ่น", "ข้าวอื่นๆ",
			                "ข้าวนึ่ง 100%", "ข้าวนึ่ง",
			                "ข้าวปทุมธานี", "ข้าวปทุมฯ",
			                "ข้าวหอมปทุมธานี", "ข้าวปทุมฯ",
			                "ข้าวหอมพวง", "ข้าวปทุมฯ",
			                "ข้าวเหนียว 10% ยาว", "ข้าวเหนียว",
			                "ปข.เจ้า A1 เลิศ", "ปลายข้าว",
			                "ปข.หอมมะลิ", "ปลายข้าว",
			                "ปข.เหนียว A1", "ปลายข้าว",
			                "หอมมะลิ 100% ชั้น 1", "ข้าวหอม",
			                "หอมมะลิ 100% ชั้น 2", "ข้าวหอม",
			                "ข้าวอื่นๆ"
			            ),
			
			        -- Fallback for any unmapped source
			        "ข้าวอื่นๆ"
			    )
		dataType: string
		lineageTag: d8123456-7890-4abc-def0-123456789001
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// ชื่อกลุ่มสินค้าข้าวมาตรฐานแยกตามแหล่งข้อมูล (S005 Oryza, S003 DIT, S001 CPI)
	column 'Domestic Product Group' =
			VAR _Source = Dim_Product[SourceCode]
			VAR _Name = TRIM(Dim_Product[Product Name])
			RETURN
			    SWITCH(
			        _Source,
			        -- Rule 1: SourceCode = S005 (Oryza)
			        "S005", _Name,
			
			        -- Rule 2: SourceCode = S003 (DIT)
			        "S003",
			            SWITCH(
			                _Name,
			                "ปลายข้าวนึ่ง เอ.วัน", "ปข.นึ่ง A1",
			                "ข้าวนึ่ง 5%", "ข้าวนึ่ง 5%",
			                "ข้าวนึ่ง 100%", "ข้าวนึ่ง 100%",
			                "ปลายข้าวเหนียว เอ.วัน(ใหม่)", "ปข.เหนียว A1 (ใหม่)",
			                "ปลายข้าวเหนียว เอ.วัน", "ปข.เหนียว A1",
			                "ข้าวสารเหนียว 10% สั้น(ใหม่)", "ข้าวเหนียว 10% สั้น (ใหม่)",
			                "ข้าวสารเหนียว 10% สั้น", "ข้าวเหนียว 10% สั้น",
			                "ข้าวสารเหนียว 10% ยาว(ใหม่)", "ข้าวเหนียว 10% ยาว (ใหม่)",
			                "ข้าวสารเหนียว 10% ยาว", "ข้าวเหนียว 10% ยาว",
			                "ข้าวเหนียว กข. 6(ใหม่)", "ข้าวเหนียว กข. 6 (ใหม่)",
			                "ข้าวเหนียว กข. 6", "ข้าวเหนียว กข. 6",
			                "ปลายข้าวขาว ซี.วัน", "ปข.ขาว C1",
			                "ปลายข้าว เอ.วัน.พิเศษ(ใหม่)", "ปข. A1.พิเศษ (ใหม่)",
			                "ปลายข้าว เอ.วัน.พิเศษ", "ปข. A1.พิเศษ",
			                "ปลายข้าวสารเจ้า เอ.วันเลิศ(ใหม่)", "ปข.เจ้า A1 เลิศ (ใหม่)",
			                "ปลายข้าวสารเจ้า เอ.วันเลิศ", "ปข.เจ้า A1 เลิศ",
			                "ปลายข้าวปทุมธานี(ใหม่)", "ปข.ปทุมธานี (ใหม่)",
			                "ปลายข้าวปทุมธานี", "ปข.ปทุมธานี",
			                "ปลายข้าวหอมมะลิ(ใหม่)", "ปข.หอมมะลิ (ใหม่)",
			                "ปลายข้าวหอมมะลิ", "ปข.หอมมะลิ",
			                "ข้าวสารเจ้า 25% เลิศ(ใหม่)", "ขข. 25% เลิศ (ใหม่)",
			                "ข้าวสารเจ้า 15%(ใหม่)", "ขข. 15% (ใหม่)",
			                "ข้าวสารเจ้า 10%(ใหม่)", "ขข. 10% (ใหม่)",
			                "ข้าวสารเจ้า 10%", "ขข. 10%",
			                "ข้าวสารเจ้า 5%(ใหม่)", "ขข. 5% (ใหม่)",
			                "ข้าวสารเจ้า 5%", "ขข. 5%",
			                "ข้าวสารเจ้า 100% ชั้น 3(ใหม่)", "ขข. 100% ชั้น 3 (ใหม่)",
			                "ข้าวสารเจ้า 100% ชั้น 3", "ขข. 100% ชั้น 3",
			                "ข้าวสารเจ้า 100% ชั้น 2(ใหม่)", "ขข. 100% ชั้น 2 (ใหม่)",
			                "ข้าวสารเจ้า 100% ชั้น 2", "ขข. 100% ชั้น 2",
			                "ข้าวสารเจ้า 100% ชั้น 1(ใหม่)", "ขข. 100% ชั้น 1 (ใหม่)",
			                "ข้าวสารเจ้า 100% ชั้น 1(ใหม่ )", "ขข. 100% ชั้น 1 (ใหม่)",
			                "ข้าวสารเจ้า 100% ชั้น 1", "ขข. 100% ชั้น 1",
			                "ข้าวปทุมธานี(ใหม่)", "ข้าวปทุมธานี (ใหม่)",
			                "ข้าวปทุมธานี", "ข้าวปทุมธานี",
			                "ข้าวหอมจังหวัด(ใหม่)", "ข้าวหอมจังหวัด (ใหม่)",
			                "ข้าวหอมจังหวัด", "ข้าวหอมจังหวัด",
			                "ข้าวหอมมะลิ 100% ชั้น 2(ใหม่)", "หอมมะลิ 100% ชั้น 2 (ใหม่)",
			                "ข้าวหอมมะลิ 100% ชั้น 2", "หอมมะลิ 100% ชั้น 2",
			                "ข้าวหอมมะลิ 100% ชั้น 1(ใหม่)", "หอมมะลิ 100% ชั้น 1 (ใหม่)",
			                "ข้าวหอมมะลิ 100% ชั้น 1", "หอมมะลิ 100% ชั้น 1",
			                _Name
			            ),
			
			        -- Rule 3: SourceCode = S001 (CPI)
			        "S001",
			            SWITCH(
			                TRUE(),
			                -- 3.1 Pattern-Based Prefix Mapping (evaluated before exact-name mapping)
			                LEFT(_Name, 14) = "ข้าวหอม 100% A" || LEFT(_Name, 14) = "ข้าวหอม 100% B", "หอมมะลิ 100% ชั้น 1",
			                LEFT(_Name, 14) = "ข้าวหอม 100% C", "หอมมะลิ 100% ชั้น 2",
			
			                -- 3.2 Product Name Mapping Table (supports both exact base names and crop-suffixed raw names)
			                _Name = "ข้าวกข.43" || LEFT(_Name, 9) = "ข้าวกข.43", "ข้าวกข.43",
			                _Name = "ข้าวกข.79" || LEFT(_Name, 9) = "ข้าวกข.79", "ข้าวกข.79",
			                _Name = "ข้าวกล้องหอม 100%" || LEFT(_Name, 12) = "ข้าวกล้องหอม", "ข้าวกล้องหอม 100%",
			                _Name = "ข้าวขาว 100% (นาปรัง)" || LEFT(_Name, 21) = "ข้าวขาว 100% (นาปรัง)", "ขข. 100% ชั้น 1",
			                _Name = "ข้าวขาว 5% (นาปรัง)" || LEFT(_Name, 19) = "ข้าวขาว 5% (นาปรัง)" || LEFT(_Name, 17) = "ข้าวขาว 5% นาปรัง", "ขข. 5%",
			                _Name = "ข้าวญี่ปุ่น กวก.2" || LEFT(_Name, 17) = "ข้าวญี่ปุ่น กวก.2", "ข้าวญี่ปุ่น",
			                _Name = "ข้าวนึ่ง 100% ดีด สี เกรด B" || CONTAINSSTRING(_Name, "ข้าวนึ่ง 100% ดีด สี"), "ข้าวนึ่ง 100%",
			                _Name = "ข้าวหอมปทุมธานี" || LEFT(_Name, 15) = "ข้าวหอมปทุมธานี", "ข้าวปทุมธานี",
			                _Name = "ข้าวหอมพวง" || LEFT(_Name, 10) = "ข้าวหอมพวง", "ข้าวหอมพวง",
			                _Name = "ข้าวเหนียวนาปรัง" || LEFT(_Name, 16) = "ข้าวเหนียวนาปรัง", "ข้าวเหนียว 10% ยาว",
			                _Name = "ปลายข้าวขาว" || LEFT(_Name, 11) = "ปลายข้าวขาว", "ปข.เจ้า A1 เลิศ",
			                _Name = "ปลายข้าวหอมมะลิ" || LEFT(_Name, 15) = "ปลายข้าวหอมมะลิ", "ปข.หอมมะลิ",
			                _Name = "ปลายข้าวเหนียว" || LEFT(_Name, 14) = "ปลายข้าวเหนียว", "ปข.เหนียว A1",
			                _Name
			            ),
			
			        -- Fallback for any other SourceCode
			        _Name
			    )
		dataType: string
		lineageTag: d8123456-7890-4abc-def0-123456789002
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// แหล่งข้อมูลราคาข้าวสำหรับตัวสลับแหล่งราคา (CPI Price / DIT Price / Oryza Price)
	column 'Price Source' =
			SWITCH(
			    Dim_Product[SourceCode],
			    "S001", "CPI Price",
			    "S003", "DIT Price",
			    "S005", "Oryza Price",
			    Dim_Product[SourceCode]
			)
		dataType: string
		lineageTag: d8123456-7890-4abc-def0-123456789003
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Dim_Product = m
		mode: import
		source =
				let
				    Source = Fact_Rice_Price,
				    #"Removed Other Columns" = Table.SelectColumns(Source,{"SourceCode", "Category Code", "Category Name", "Sub Category Code", "Sub Category Name", "Product Code", "Product Name"}),
				    #"Removed Duplicates" = Table.Distinct(#"Removed Other Columns", {"Product Code"}),
				    #"Sorted Rows" = Table.Sort(#"Removed Duplicates",{{"Product Code", Order.Ascending}}),
				    #"Add New Sub Cat Name for Oryza" = Table.AddColumn(
				    #"Sorted Rows",
				    "New Sub Category Name",
				    each
				        Record.FieldOrDefault(
				            [
				                P00000000238 = "White Rice-High",
				                P00000000239 = "White Rice-High",
				                P00000000240 = "White Rice-High",
				                P00000000241 = "White Rice-High",
				                P00000000242 = "White Rice-High",
				                P00000000243 = "White Rice-High",
				                P00000000245 = "White Rice-High",
				                P00000000246 = "White Rice-High",
				                P00000000247 = "White Rice-High",
				                P00000000651 = "White Rice-High",
				
				                P00000000248 = "White Rice-Low",
				                P00000000249 = "White Rice-Low",
				                P00000000250 = "White Rice-Low",
				                P00000000252 = "White Rice-Low",
				                P00000000253 = "White Rice-Low",
				
				                P00000000254 = "Parboiled Rice",
				                P00000000255 = "Parboiled Rice",
				                P00000000256 = "Parboiled Rice",
				                P00000000257 = "Parboiled Rice",
				                P00000000258 = "Parboiled Rice",
				                P00000000259 = "Parboiled Rice",
				
				                P00000000260 = "Fragrant Rice",
				                P00000000261 = "Fragrant Rice",
				
				                P00000000265 = "Broken Rice",
				                P00000000266 = "Broken Rice",
				                P00000000267 = "Broken Rice",
				                P00000000269 = "Broken Rice",
				                P00000000271 = "Broken Rice",
				
				                P00000000273 = "Medium Grain",
				                P00000000501 = "Medium Grain"
				            ],
				            [Product Code],
				            [Sub Category Name]
				        )
				)
				in
				    #"Add New Sub Cat Name for Oryza"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

