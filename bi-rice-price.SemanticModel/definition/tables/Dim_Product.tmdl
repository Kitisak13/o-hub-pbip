	column 'New Sub Category Name'
		dataType: string
		lineageTag: c203ed4f-5486-4918-b825-a641278baefa
		summarizeBy: none
		sourceColumn: New Sub Category Name

		annotation SummarizationSetBy = Automatic

	/// กลุ่มเปรียบเทียบมาตรฐานเชื่อมโยง 3 แหล่งข้อมูล (CPI, DIT, Oryza)
	column 'Benchmark Group' =
			VAR _Name = Dim_Product[Product Name]
			VAR _SubCat = Dim_Product[New Sub Category Name]
			RETURN
			    SWITCH(
			        TRUE(),
			        -- 1. Broken Rice must be checked BEFORE Hom Mali ("ปลายข้าวหอมมะลิ")
			        CONTAINSSTRING(_Name, "ปลายข้าว") || CONTAINSSTRING(_Name, "A1") || CONTAINSSTRING(_Name, "100% broken") || CONTAINSSTRING(_Name, "100% Broken") || CONTAINSSTRING(_Name, "pet food") || _SubCat = "Broken Rice", "Broken Rice",
			        -- 2. Parboiled Rice must be checked BEFORE "5% broken" ("India parboiled 5% broken")
			        CONTAINSSTRING(_Name, "ข้าวนึ่ง") || CONTAINSSTRING(_Name, "parboiled") || CONTAINSSTRING(_Name, "Parboiled") || _SubCat = "Parboiled Rice", "Parboiled Rice",
			        -- 3. Glutinous & Medium/Specialty Grain must be checked BEFORE "4% broken" ("U.S. Calrose 4% broken")
			        CONTAINSSTRING(_Name, "เหนียว") || CONTAINSSTRING(_Name, "กข") || CONTAINSSTRING(_Name, "ญี่ปุ่น") || CONTAINSSTRING(_Name, "กล้อง") || CONTAINSSTRING(_Name, "Calrose") || CONTAINSSTRING(_Name, "risotto") || _SubCat = "Medium Grain", "Glutinous & Specialty",
			        -- 4. Pathumthani / Fragrant
			        CONTAINSSTRING(_Name, "ปทุม") || CONTAINSSTRING(_Name, "หอมพวง"), "Fragrant (Pathumthani)",
			        -- 5. Hom Mali / Jasmine
			        CONTAINSSTRING(_Name, "หอมมะลิ") || CONTAINSSTRING(_Name, "ข้าวหอม 100%") || CONTAINSSTRING(_Name, "Hommali") || CONTAINSSTRING(_Name, "Jasmine") || _SubCat = "Fragrant Rice", "Hom Mali / Fragrant",
			        -- 6. White Rice 15-25% must be checked BEFORE "5% broken" (since "25% broken" and "15% broken" contain "5% broken")
			        CONTAINSSTRING(_Name, "25% broken") || CONTAINSSTRING(_Name, "15% broken") || CONTAINSSTRING(_Name, "25%") || CONTAINSSTRING(_Name, "15%") || _SubCat = "White Rice-Low", "White Rice 15-25%",
			        -- 7. White Rice 100%
			        CONTAINSSTRING(_Name, "ขาว 100%") || CONTAINSSTRING(_Name, "100% B"), "White Rice 100%",
			        -- 8. White Rice 5%
			        CONTAINSSTRING(_Name, "ขาว 5%") || CONTAINSSTRING(_Name, "5% broken") || CONTAINSSTRING(_Name, "4% broken") || _SubCat = "White Rice-High", "White Rice 5%",
			        "Other Rice"
			    )
		dataType: string
		lineageTag: d8123456-7890-4abc-def0-123456789001
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// ชื่อกลุ่มสินค้าข้าวในประเทศ (รวมรหัสฤดูกาลผลิตของ CPI เข้าด้วยกันเพื่อให้ง่ายต่อการเปรียบเทียบ)
	column 'Domestic Product Group' =
			VAR _Name = Dim_Product[Product Name]
			RETURN
			    SWITCH(
			        TRUE(),
			        LEFT(_Name, 12) = "ข้าวหอม 100%", "ข้าวหอม 100%",
			        LEFT(_Name, 15) = "ข้าวหอมปทุมธานี", "ข้าวหอมปทุมธานี",
			        LEFT(_Name, 10) = "ข้าวหอมพวง", "ข้าวหอมพวง",
			        LEFT(_Name, 17) = "ข้าวขาว 5% นาปรัง", "ข้าวขาว 5% นาปรัง",
			        LEFT(_Name, 21) = "ข้าวขาว 100% (นาปรัง)", "ข้าวขาว 100% (นาปรัง)",
			        LEFT(_Name, 15) = "ปลายข้าวหอมมะลิ", "ปลายข้าวหอมมะลิ",
			        LEFT(_Name, 16) = "ข้าวเหนียวนาปรัง", "ข้าวเหนียวนาปรัง",
			        LEFT(_Name, 11) = "ปลายข้าวขาว", "ปลายข้าวขาว",
			        LEFT(_Name, 14) = "ปลายข้าวเหนียว", "ปลายข้าวเหนียว",
			        CONTAINSSTRING(_Name, "ข้าวนึ่ง 100% ดีด สี"), "ข้าวนึ่ง 100% ดีด สี เกรด B",
			        LEFT(_Name, 9) = "ข้าวกข.43", "ข้าวกข.43",
			        LEFT(_Name, 17) = "ข้าวญี่ปุ่น กวก.2", "ข้าวญี่ปุ่น กวก.2",
			        LEFT(_Name, 9) = "ข้าวกข.79", "ข้าวกข.79",
			        LEFT(_Name, 12) = "ข้าวกล้องหอม", "ข้าวกล้องหอม 100%",
			        _Name
			    )
		dataType: string
		lineageTag: d8123456-7890-4abc-def0-123456789002
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Dim_Product = m
		mode: import
		source =
				let
				    Source = Fact_Rice_Price,
				    #"Removed Other Columns" = Table.SelectColumns(Source,{"SourceCode", "Category Code", "Category Name", "Sub Category Code", "Sub Category Name", "Product Code", "Product Name"}),
				    #"Removed Duplicates" = Table.Distinct(#"Removed Other Columns", {"Product Code"}),
				    #"Sorted Rows" = Table.Sort(#"Removed Duplicates",{{"Product Code", Order.Ascending}}),
				    #"Add New Sub Cat Name for Oryza" = Table.AddColumn(
				    #"Sorted Rows",
				    "New Sub Category Name",
				    each
				        Record.FieldOrDefault(
				            [
				                P00000000238 = "White Rice-High",
				                P00000000239 = "White Rice-High",
				                P00000000240 = "White Rice-High",
				                P00000000241 = "White Rice-High",
				                P00000000242 = "White Rice-High",
				                P00000000243 = "White Rice-High",
				                P00000000245 = "White Rice-High",
				                P00000000246 = "White Rice-High",
				                P00000000247 = "White Rice-High",
				                P00000000651 = "White Rice-High",
				
				                P00000000248 = "White Rice-Low",
				                P00000000249 = "White Rice-Low",
				                P00000000250 = "White Rice-Low",
				                P00000000252 = "White Rice-Low",
				                P00000000253 = "White Rice-Low",
				
				                P00000000254 = "Parboiled Rice",
				                P00000000255 = "Parboiled Rice",
				                P00000000256 = "Parboiled Rice",
				                P00000000257 = "Parboiled Rice",
				                P00000000258 = "Parboiled Rice",
				                P00000000259 = "Parboiled Rice",
				
				                P00000000260 = "Fragrant Rice",
				                P00000000261 = "Fragrant Rice",
				
				                P00000000265 = "Broken Rice",
				                P00000000266 = "Broken Rice",
				                P00000000267 = "Broken Rice",
				                P00000000269 = "Broken Rice",
				                P00000000271 = "Broken Rice",
				
				                P00000000273 = "Medium Grain",
				                P00000000501 = "Medium Grain"
				            ],
				            [Product Code],
				            [Sub Category Name]
				        )
				)
				in
				    #"Add New Sub Cat Name for Oryza"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

