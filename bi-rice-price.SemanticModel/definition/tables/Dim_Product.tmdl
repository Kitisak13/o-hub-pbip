				                P00000000246 = "White Rice-High",
				                P00000000247 = "White Rice-High",
				                P00000000651 = "White Rice-High",
				
				                P00000000248 = "White Rice-Low",
				                P00000000249 = "White Rice-Low",
				                P00000000250 = "White Rice-Low",
				                P00000000252 = "White Rice-Low",
				                P00000000253 = "White Rice-Low",
				
				                P00000000254 = "Parboiled Rice",
				                P00000000255 = "Parboiled Rice",
				                P00000000256 = "Parboiled Rice",
				                P00000000257 = "Parboiled Rice",
				                P00000000258 = "Parboiled Rice",
				                P00000000259 = "Parboiled Rice",
				
				                P00000000260 = "Fragrant Rice",
				                P00000000261 = "Fragrant Rice",
				
				                P00000000265 = "Broken Rice",
				                P00000000266 = "Broken Rice",
				                P00000000267 = "Broken Rice",
				                P00000000269 = "Broken Rice",
				                P00000000271 = "Broken Rice",
				
				                P00000000273 = "Medium Grain",
				                P00000000501 = "Medium Grain"
				            ],
				            [Product Code],
				            [Sub Category Name]
				        )
				)
				in
				    #"Add New Sub Cat Name for Oryza"

	annotation PBI_NavigationStepName = Navigation

