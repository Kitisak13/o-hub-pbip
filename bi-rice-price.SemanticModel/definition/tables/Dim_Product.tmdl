	partition Dim_Product = m
		mode: import
		source =
				let
				    Source = Fact_Rice_Price,
				    #"Removed Other Columns" = Table.SelectColumns(Source,{"SourceCode", "Category Code", "Category Name", "Sub Category Code", "Sub Category Name", "Product Code", "Product Name"}),
				    #"Removed Duplicates" = Table.Distinct(#"Removed Other Columns"),
				    #"Sorted Rows" = Table.Sort(#"Removed Duplicates",{{"Product Code", Order.Ascending}}),
				    #"Add New Sub Cat Name for Oryza" = Table.AddColumn(
				    #"Sorted Rows",
				    "New Sub Category Name",
				    each
				        Record.FieldOrDefault(
				            [
				                P00000000238 = "White Rice-High",
				                P00000000239 = "White Rice-High",
				                P00000000240 = "White Rice-High",
				                P00000000241 = "White Rice-High",
				                P00000000242 = "White Rice-High",
